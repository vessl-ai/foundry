diff --git a/python/sglang/srt/foundry_shim.py b/python/sglang/srt/foundry_shim.py
new file mode 100644
index 0000000..8fa5997
--- /dev/null
+++ b/python/sglang/srt/foundry_shim.py
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Small activation shim for the Foundry SGLang integration."""
+
+from __future__ import annotations
+
+import logging
+import os
+
+logger = logging.getLogger(__name__)
+
+
+def apply_server_args(server_args) -> None:
+    cfg_path = getattr(server_args, "foundry_graph_extension_config_path", None)
+    if not cfg_path:
+        return
+
+    # Keep phase-1 SAVE/LOAD deterministic while preserving full-graph
+    # torch.compile semantics. Assignments are idempotent-safe (a worker
+    # process re-applies over an already-configured server_args) and
+    # frozen-safe (forks that freeze server_args after resolution).
+    def _force(name, value):
+        if getattr(server_args, name, None) == value:
+            return
+        try:
+            setattr(server_args, name, value)
+        except AttributeError:
+            try:
+                from sglang.srt.runtime_context import get_context
+
+                get_context().override("foundry", **{name: value})
+            except Exception:
+                logger.warning(
+                    "[Foundry] cannot override %s on frozen server_args", name
+                )
+
+    # NOTE: piecewise CUDA graphs are selected per phase through
+    # ``cuda_graph_config`` (full / breakable / tc_piecewise / disabled) on
+    # this tree; there is no ``disable_piecewise_cuda_graph`` flag to force
+    # here.  install_hooks() inspects the resolved config in the worker and
+    # warns when a phase asks for tc_piecewise, which foundry does not cache.
+    _force("enable_profile_cuda_graph", False)
+    _force("disable_flashinfer_autotune", True)
+
+    from foundry.integration.sglang.hooks import install_hooks
+
+    install_hooks(server_args)
+    logger.info("Foundry SGLang integration activated from %s", cfg_path)
